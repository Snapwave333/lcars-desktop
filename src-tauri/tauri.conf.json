{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LCARS Shell",
  "version": "0.1.0",
  "identifier": "com.lcars.shell",
  "build": {
    "frontendDist": "../frontend/dist/lcars-frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": {
      "script": "npm run start",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LCARS Shell",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
