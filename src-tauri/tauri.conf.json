{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "LCARS Shell",
  "version": "0.1.0",
  "identifier": "com.lcars.shell",
  "build": {
    "frontendDist": "../frontend/dist/lcars-frontend/browser",
    "devUrl": null,
    "beforeDevCommand": {
      "script": "npm run start",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LCARS Shell",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
